# Copy to .env and edit. Comma- or whitespace-separated lists.

# Hosts that must go through the GlobalProtect tunnel.
#   exact host:   bitbucket.juspay.net
#   wildcard:     *.juspay.net      (matches juspay.net and all subdomains)
#   CIDR:         10.0.0.0/8        (only when the app connects to an IP literal)
VPN_HOSTS=bitbucket.juspay.net,*.juspay.net

# Hosts that must bypass the tunnel (only useful when DEFAULT_ROUTE=vpn).
DIRECT_HOSTS=

# Where unmatched hosts go: "direct" (bypass tunnel) or "vpn".
DEFAULT_ROUTE=direct

# Interfaces. "auto" detects the GlobalProtect utun/gpd interface and your
# physical en* interface every few seconds, so GP reconnects are picked up.
VPN_IFACE=auto
DIRECT_IFACE=auto

# DNS. VPN_DNS empty => use the servers GlobalProtect pushed (from scutil --dns).
# DIRECT_DNS is queried over the physical interface so VPN-side DNS filtering
# can't block youtube etc.
VPN_DNS=
DIRECT_DNS=1.1.1.1,8.8.8.8

HTTP_LISTEN=127.0.0.1:8080
SOCKS_LISTEN=127.0.0.1:1080
LOG_LEVEL=INFO
